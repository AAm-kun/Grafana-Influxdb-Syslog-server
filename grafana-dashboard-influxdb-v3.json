                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "queryType": "sql",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  $__dateBin(time) AS time,\n  count(*) AS \"Info\"\nFROM syslog\nWHERE $__timeFilter(time)\n  AND severity = 'info'\n  AND hostname IN (${hostname:sqlstring})\n  AND appname IN (${appname:sqlstring})\n  AND severity IN (${severity:sqlstring})\n  AND message ILIKE '%${Query:raw}%'\nGROUP BY $__dateBin(time)\nORDER BY time",
                        "resultFormat": "time_series"
